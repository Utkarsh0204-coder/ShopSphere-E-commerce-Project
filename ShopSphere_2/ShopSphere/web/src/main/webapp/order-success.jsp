<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Order Confirmed | ShopSphere" scope="request"/>
<%@ include file="fragments/header.jsp" %><%@ include file="fragments/navbar.jsp" %>
<main class="container py-5"><section class="order-success"><div class="success-icon">✓</div><h1>Order placed successfully!</h1><p>Your ShopSphere demo order has been saved to the database.</p><c:if test="${not empty sessionScope.lastOrderId}"><p class="order-number">Order number: <strong>#<c:out value="${sessionScope.lastOrderId}"/></strong></p></c:if><div class="d-flex justify-content-center flex-wrap gap-3 mt-4"><a class="btn btn-primary" href="${pageContext.request.contextPath}/orders">View my orders</a><a class="btn btn-outline-dark" href="${pageContext.request.contextPath}/products">Continue shopping</a></div><p class="muted small mt-4">Demo checkout only: no real payment is collected.</p></section></main><style>.order-success{max-width:720px;margin:25px auto;padding:56px 24px;text-align:center;background:#fff;border:1px solid #e2e8f0;border-radius:20px;box-shadow:0 12px 35px #0f172a0c}.success-icon{display:grid;place-items:center;width:76px;height:76px;margin:0 auto 20px;border-radius:50%;background:#dcfce7;color:#15803d;font-size:2.5rem;font-weight:800}.order-success h1{font-size:clamp(1.8rem,4vw,2.6rem)}.order-number{margin-top:20px;padding:12px;background:#f8fafc;border-radius:10px}</style>
<%@ include file="fragments/footer.jsp" %>
